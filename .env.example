LLM_BASE_URL=https://nano-gpt.com/api/subscription/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5.3
VISION_MODEL=moonshotai/kimi-k2.6
NANOGPT_API_URL=https://nano-gpt.com
STT_MODEL=Whisper-Large-V3
# Sal's speaking voice (NanoGPT text-to-speech); the instructions steer models that take them
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=onyx
TTS_INSTRUCTIONS=
# how many people dinner is for; defaults to everyone in the household
HOUSEHOLD_SIZE=
MEALIE_URL=
MEALIE_PUBLIC_URL=
MEALIE_API_TOKEN=
CALENDAR_ICS_URLS=
TZ=America/New_York
SETUP_TOKEN=
DATA_DIR=./data
# web push reminders: make a pair with `npx web-push generate-vapid-keys`, never commit them
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# the app's public https address, used as the VAPID subject unless VAPID_SUBJECT is set
# (iPhones reject pushes signed with the https://localhost fallback)
APP_URL=
VAPID_SUBJECT=
